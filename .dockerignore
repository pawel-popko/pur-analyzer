#############################################
#  PurAnalyzer - .dockerignore
#  Optimized for .NET 8 + Clean Architecture
#############################################

# ============================================================
# Ignore build outputs (binaries, caches, coverage)
# ============================================================
**/bin/
**/obj/
**/out/
**/publish/
**/artifacts/
**/logs/
**/log/
**/temp/
**/tmp/
**/[Tt]est[Rr]esults/
**/coverage/
**/coverage-report/

# ============================================================
# Ignore IDE & tool configurations
# ============================================================
.vscode/
.vs/
.idea/
*.code-workspace
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# ============================================================
# Ignore version control and Git metadata
# ============================================================
.git/
.gitignore
.gitattributes
.gitmodules

# ============================================================
# Ignore environment and secrets
# ============================================================
.env
.env.*
*.local.json
appsettings.*.local.json
secrets.json

# ============================================================
# Ignore Docker-specific files not needed in build context
# ============================================================
docker-compose.*
Dockerfile.*~
**/pgdata/
**/postgres-data/
**/docker-compose.override.yml
**/docker-compose.*.yml.user

# ============================================================
# Ignore test projects (we don't build tests inside image)
# ============================================================
tests/
**/tests/
**/*.Tests/
**/*.Tests.*
**/*.UnitTests/
**/*.IntegrationTests/

# ============================================================
# Ignore dependency caches and package artifacts
# ============================================================
*.nupkg
*.snupkg
*.nuspec
packages/
.nuget/
node_modules/
bower_components/

# ============================================================
# Ignore operating system junk
# ============================================================
Thumbs.db
Desktop.ini
ehthumbs.db
.DS_Store
$RECYCLE.BIN/
*.lnk

# ============================================================
# Ignore temporary or backup files
# ============================================================
*.bak
*.orig
*.tmp
*.temp
*.swp
*.cache
*.log

# ============================================================
# Ignore solution-level generated files
# ============================================================
PurAnalyzer.sln.iml
PurAnalyzer.sln.DotSettings.user

#############################################
# End of file
#############################################
