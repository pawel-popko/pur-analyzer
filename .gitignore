.vs/
.vscode/
.idea/
*.ncrunchsolution

# Allow test coverage results and reports
# Allow test coverage results and reports
!coverage-report/
!coverage-report/coverage/
!coverage-report/coverage/coverage.cobertura.xml
!coverage-report/report/
!coverage-report/report/**

# --- Allow project config JSONs & launch settings (but keep *local.json ignored) ---
!**/appsettings.json
!**/appsettings.Development.json
!**/Properties/launchSettings.json

