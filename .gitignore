Thumbs.db
Desktop.ini
ehthumbs.db
.DS_Store
$RECYCLE.BIN/
*.lnk

# ReSharper
_ReSharper*/
*.DotSettings.user
*.DotCover

# Rider
.idea/
*.iml
.sln.iml

# Visual Studio Code workspace
*.code-workspace

# JetBrains Rider test reports
*.html
*.json
*.xml
*.csv

# Local environment and secrets
.env
.env.*
*.local.json
appsettings.*.local.json
secrets.json

# Docker-related
docker-compose.override.yml
**/docker-compose.override.yml
**/docker-compose.*.yml.user
*.pid
**/pgdata/
**/postgres-data/

