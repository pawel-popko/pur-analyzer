*.nupkg
*.snupkg
*.nuspec
packages/
.nuget/
*.lock.json

# Publish outputs
/dist/
publish/
out/
artifacts/
deploy/
*.publish.xml

# Auto-generated files
Generated_Code/
ServiceFabricBackup/
ClientApp/node_modules/
node_modules/
bower_components/

